# WebDAV credentials Tampermonkey logs in with. Use a long random password.
WEBDAV_USER=
WEBDAV_PASS=
# Fine-grained PAT with "Contents: read and write" on GITHUB_REPO only.
GITHUB_TOKEN=
# owner/name of a (private) repo that holds the synced files.
GITHUB_REPO=
GITHUB_BRANCH=main
# Folder inside the repo for synced files; empty means the repo root.
GITHUB_PATH_PREFIX=
