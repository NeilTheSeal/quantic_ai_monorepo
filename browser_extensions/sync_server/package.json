{
  "name": "tampermonkey-sync-server",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal WebDAV server for Tampermonkey sync, backed by a GitHub repo",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "typecheck": "tsc",
    "test": "node --test tests/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
