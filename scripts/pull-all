#!/usr/bin/env bash
# Pull `main` from `origin` in every repository listed in repos.json. Other remotes (heroku, …)
# and other branches are left alone.
#
#   pull-all            fast-forward main in each repo
#   pull-all --dry-run  show what would be fetched without changing anything
#
# A repo whose path does not exist yet is cloned first (`main` only). Remotes listed in
# repos.json that the clone lacks (e.g. heroku) are added. A repo checked out on another branch
# gets its local main fast-forwarded in place (`git fetch origin main:main`) so the working tree
# is not disturbed.
set -euo pipefail

dry_run=0
case "${1:-}" in
  "") ;;
  --dry-run) dry_run=1 ;;
  *)
    echo "usage: pull-all [--dry-run]" >&2
    exit 2
    ;;
esac

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${script_dir}/.." && pwd)"
manifest="${root}/repos.json"

for tool in git python3; do
  if ! command -v "${tool}" >/dev/null; then
    echo "pull-all: ${tool} is required" >&2
    exit 1
  fi
done

# One "path<TAB>origin-url<TAB>name=url name=url…" line per repo that has an origin remote; the
# third field lists the other remotes so they can be added to a fresh clone.
repos="$(python3 - "${manifest}" <<'EOF'
import json, sys
with open(sys.argv[1], encoding="utf-8") as f:
    data = json.load(f)
for repo in data["repositories"]:
    remotes = repo.get("remotes", {})
    origin = remotes.get("origin")
    if origin is None:
        print(f"{repo['name']}: no origin remote in repos.json, skipped", file=sys.stderr)
        continue
    others = " ".join(f"{n}={r['fetch']}" for n, r in remotes.items() if n != "origin")
    print(f"{repo['path']}\t{origin['fetch']}\t{others}")
EOF
)"

# Fast-forward the checked-out main. Deliberately not `git pull`: pull merges whatever FETCH_HEAD
# says, and FETCH_HEAD is appended to without locking, so a fetch running at the same time (VS
# Code autofetch, the repo_watch extension) leaves two `main` lines in it and pull fails with
# "Cannot fast-forward to multiple branches". The remote-tracking ref has no such race.
ff_main() {
  git -C "$1" fetch origin main && git -C "$1" merge --ff-only refs/remotes/origin/main
}

failed=0
while IFS=$'\t' read -r rel url others; do
  [ -n "${rel}" ] || continue
  dir="${root}/${rel}"
  if [ "${rel}" = "." ]; then dir="${root}"; fi
  label="${rel}"
  echo "== ${label}"

  if [ ! -d "${dir}/.git" ]; then
    echo "   not cloned; cloning main from ${url}"
    if [ "${dry_run}" -eq 1 ]; then
      echo "   would run: git clone --branch main --single-branch ${url} ${dir}"
      continue
    fi
    if ! git clone --branch main --single-branch "${url}" "${dir}" 2>&1 | sed 's/^/   /'; then
      failed=$((failed + 1))
      continue
    fi
  fi

  # Remotes the manifest knows about but the clone does not (a fresh clone has only origin).
  for pair in ${others}; do
    name="${pair%%=*}"
    remote_url="${pair#*=}"
    if ! git -C "${dir}" remote get-url "${name}" >/dev/null 2>&1; then
      if [ "${dry_run}" -eq 1 ]; then
        echo "   would run: git remote add ${name} ${remote_url}"
      else
        git -C "${dir}" remote add "${name}" "${remote_url}"
        echo "   added remote ${name} -> ${remote_url}"
      fi
    fi
  done

  actual="$(git -C "${dir}" remote get-url origin 2>/dev/null || true)"
  if [ "${actual}" != "${url}" ]; then
    echo "warn ${label}: origin is '${actual}', manifest says '${url}'" >&2
  fi

  branch="$(git -C "${dir}" branch --show-current)"
  if [ "${branch}" = "main" ]; then
    cmd=(ff_main "${dir}")
    desc="git fetch origin main && git merge --ff-only refs/remotes/origin/main"
  else
    echo "note ${label}: on '${branch}', updating local main without touching the worktree" >&2
    cmd=(git -C "${dir}" fetch origin main:main)
    desc="${cmd[*]}"
  fi

  if [ "${dry_run}" -eq 1 ]; then
    echo "   would run: ${desc}"
    git -C "${dir}" fetch --dry-run origin main 2>&1 | sed 's/^/   /' || failed=$((failed + 1))
  else
    "${cmd[@]}" 2>&1 | sed 's/^/   /' || failed=$((failed + 1))
  fi
done <<<"${repos}"

if [ "${failed}" -ne 0 ]; then
  echo "pull-all: ${failed} repo(s) failed" >&2
  exit 1
fi
