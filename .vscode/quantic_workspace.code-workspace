{
  // One folder. Nested repos from repos.json are added to Source Control by the repo_watch
  // extension; the folder is named because the terminal PATH below refers to it by name.
  "folders": [{ "name": "quantic_ai_monorepo", "path": ".." }],
  "settings": {
    "black-formatter.enabled": false,
    "pylint.enabled": false,
    "ms-python.black-formatter.enabled": false,
    "ms-python.pylint.enabled": false,
    "editor.formatOnSave": true,

    // Repo scripts (type-check-all, lint-check-all, format-check-all) on PATH in the terminal.
    // Window-scoped, so it must live here rather than in .vscode/settings.json.
    // Named folder, not ${workspaceFolder}: with several folders that would resolve to whichever
    // folder a terminal opens in.
    "terminal.integrated.env.linux": {
      "PATH": "${workspaceFolder:quantic_ai_monorepo}/scripts:${env:PATH}",
    },
    "terminal.integrated.env.osx": {
      "PATH": "${workspaceFolder:quantic_ai_monorepo}/scripts:${env:PATH}",
    },
    "repoWatch.toastSeverities": ["error", "warning"],
    "repoWatch.enabled": true,
    "repoWatch.intervalMinutes": 10,
    "repoWatch.runOnStartup": true,
    "repoWatch.fetchAll.script": "${workspaceFolder}/scripts/fetch-all",
    "repoWatch.fetchAll.python": "python3",
  },
}
