{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run repo_watch extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder:quantic_ai_monorepo}/browser_extensions/repo_watch",
        "${workspaceFolder:quantic_ai_monorepo}"
      ],
      "outFiles": [
        "${workspaceFolder:quantic_ai_monorepo}/browser_extensions/repo_watch/out/**/*.js"
      ],
      "preLaunchTask": "build repo_watch"
    }
  ]
}
