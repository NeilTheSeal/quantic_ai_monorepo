{
  "version": "2.0.0",
  "tasks": [
    {
      // Fast-forward `main` from `origin` in every repo listed in repos.json when the
      // workspace opens. VS Code asks once to allow automatic tasks for this folder.
      "label": "pull-all on open",
      "type": "shell",
      "command": "${workspaceFolder:quantic_ai_monorepo}/scripts/pull-all",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "revealProblems": "onProblem",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "build repo_watch",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder:quantic_ai_monorepo}/browser_extensions/repo_watch"
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
